{
  "manifest_version": 3,
  "name": "Japanese Translator for Udemy",
  "short_name": "Japanese for Udemy",
  "version": "1.0.0",
  "key": "",
  "description": "Udemy のクイズと動画字幕を Chrome 内蔵の Translator API で PC 内で日本語に翻訳します。アイコンをクリックすると開発者用語辞書エディターがサイドパネルに開きます。",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "単語帳を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "editor/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.udemy.com/*",
        "https://udemy.com/*"
      ],
      "js": [
        "dictionary-terms.js",
        "dictionary.js",
        "translator.js",
        "content.js",
        "caption.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
